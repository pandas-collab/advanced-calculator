{
  "dependencies": {
    "morgan": "^1.10.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mathjs": "^11.11.0"
  },
  "name": "monorepo-workspace",
  "version": "1.0.0",
  "description": "Monorepo workspace for frontend and backend applications",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
  "dependencies": {
    "morgan": "^1.10.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mathjs": "^11.11.0"
  },
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces",
    "install:all": "npm install --workspaces",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend"
  },
  "devDependencies": {
  "dependencies": {
    "morgan": "^1.10.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mathjs": "^11.11.0"
  },
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  },
  "engines": {
  "dependencies": {
    "morgan": "^1.10.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mathjs": "^11.11.0"
  },
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "monorepo",
    "workspace",
    "fullstack"
  ],
  "author": "",
  "license": "MIT"
}